<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="zpouitest.controller.PO_header">

    <Page id="_IDGenPage" title="PO Header Entry">

        <!-- Input Section -->
        <VBox id="_IDGenVBox" class="sapUiSmallMargin" justifyContent="SpaceBetween">
            <Label id="_IDGenLabel" text="Purchase Order" required="true"/>
            <Input id="_IDGenInput" value="{formData>/purchaseorder}" placeholder="Enter PO Number" width="300px"  />

            <Label id="_IDGenLabel1" text="Creation Date"/>
            <DatePicker id="_IDGenDatePicker" value="{formData>/creationdate}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" width="300px"/>

            <Label id="_IDGenLabel2" text="Purchase Order Date"/>
            <DatePicker id="_IDGenDatePicker1" value="{formData>/purchaseorderdate}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" width="300px"/>

            <HBox id="_IDGenHBox">
                <Button id="_IDGenButton" text="Save" press=".onSave" type="Emphasized" class="sapUiSmallMarginTop" width="80px"/>
                <Button id="_IDGenButton1" text="Update" press=".onUpdate" type="Emphasized" class="sapUiSmallMarginTop" width="80px"/>
                <Button id="_IDGenButton2" text="Delete" press=".onDelete" type="Emphasized" class="sapUiSmallMarginTop" width="80px"/>
            </HBox>
        </VBox>

        <VBox id="_IDGenVBox1">
            <!-- Go Button -->
            <HBox id="_IDGenHBox1">
                <Button id="_IDGenButton3" text="Go" press=".onGo" type="Emphasized" class="sapUiSmallMarginTop" width="80px"/>
            </HBox>

            <!-- Table to display saved data -->
            <Table id="poTable"
                   items="{tableData>/poHeaders}"
                   selectionMode="Single"
                   selectionChange=".onRowSelect">
                <headerToolbar>
                    <Toolbar id="_IDGenToolbar">
                        <Title id="_IDGenTitle" text="Saved PO Headers"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn"><Text id="_IDGenText" text="PO Number"/></Column>
                    <Column id="_IDGenColumn1"><Text id="_IDGenText1" text="Creation Date"/></Column>
                    <Column id="_IDGenColumn2"><Text id="_IDGenText2" text="PO Date"/></Column>
                    <Column id="_IDGenColumn3"><Text id="_IDGenText3" text="Created By"/></Column>
                    <Column id="_IDGenColumn4" hAlign="Center" width="150px"><Text id="_IDGenText4" text="Actions"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem1">
                        <cells>
                            <Text id="_IDGenText5" text="{tableData>purchaseorder}"/>
                            <Text id="_IDGenText6" text="{tableData>creationdate}"/>
                            <Text id="_IDGenText7" text="{tableData>purchaseorderdate}"/>
                            <Text id="_IDGenText8" text="{tableData>createdby}"/>

                            <!-- Action buttons -->
                            <HBox id="_IDGenHBox2" justifyContent="End" fitContainer="true">
                                <Button id="_IDGenButton4" icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit"
                                        press=".onEditRow"/>
                                <Button id="_IDGenButton5" icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Delete"
                                        press=".onDeleteRow"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
